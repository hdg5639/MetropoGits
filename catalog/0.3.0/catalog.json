  "rules": [
    {
      "changeSummary": "Require the Spring Web declaration with an exact RestClient import.",
      "ecosystem": "maven",
      "fixtures": {
        "negative": [
          "http/rest-client-lookalike"
        ],
        "positive": [
          "http/rest-client"
        ]
      },
      "id": "http.rest-client",
      "match": {
        "codeSignatures": [
          {
            "kind": "IMPORT",
            "value": "org.springframework.web.client.RestClient"
          }
        ],
        "configSignatures": [],
        "packageCoordinates": [
          "org.springframework:spring-web"
        ]
      },
      "negativePredicates": [],
      "produces": {
        "archetypeFamily": "PORT",
        "capabilities": [
          "API"
        ],
        "roles": [
          "HTTP_CLIENT"
        ],
        "technology": "SPRING_REST_CLIENT",
        "usage": "DIRECT"
      },
      "references": [
        {
          "license": "Apache-2.0",
          "title": "Spring Framework REST Clients documentation",
          "url": "https://docs.spring.io/spring-framework/reference/integration/rest-clients.html"
        }
      ],
      "requiredEvidence": [
        "IMPORT",
        "MANIFEST"
      ],
      "version": "1.1.0"
    },
