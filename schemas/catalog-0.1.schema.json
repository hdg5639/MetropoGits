{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metropogits.dev/schemas/catalog-0.1.schema.json",
  "title": "MetropoGits Technology Catalog v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": "catalog/0.1"
    },
    "catalogVersion": {
      "$ref": "#/$defs/semanticVersion"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "tag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "exactValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "not": {
        "pattern": "[\\*?\\[\\]{}()|^$+]"
      }
    },
    "fixtureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ANNOTATION",
            "CALL",
            "IMPORT",
            "INHERITANCE"
          ]
        },
        "value": {
          "$ref": "#/$defs/exactValue"
        }
      }
    },
    "configSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/exactValue"
        },
        "value": {
          "$ref": "#/$defs/exactValue"
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ANNOTATION",
            "CALL",
            "CONFIG",
            "IMPORT",
            "INHERITANCE",
            "MANIFEST"
          ]
        },
        "value": {
          "$ref": "#/$defs/exactValue"
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageCoordinates",
        "codeSignatures",
        "configSignatures"
      ],
      "properties": {
        "packageCoordinates": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/exactValue"
          },
          "uniqueItems": true
        },
        "codeSignatures": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/signature"
          },
          "uniqueItems": true
        },
        "configSignatures": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/configSignature"
          },
          "uniqueItems": true
        }
      },
      "anyOf": [
        {
          "properties": {
            "packageCoordinates": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "codeSignatures": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "configSignatures": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "produces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technology",
        "capabilities",
        "roles",
        "archetypeFamily",
        "usage"
      ],
      "properties": {
        "technology": {
          "$ref": "#/$defs/tag"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "API",
              "AUTH",
              "BUILD",
              "CACHE",
              "DOCUMENT_DB",
              "OBJECT_STORAGE",
              "OTHER",
              "QUEUE",
              "RELATIONAL_DB",
              "SEARCH",
              "STREAM",
              "TEST",
              "UI"
            ]
          },
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          },
          "uniqueItems": true
        },
        "archetypeFamily": {
          "enum": [
            "CACHE_TOWER",
            "CONTROL_CENTER",
            "DOCUMENT_DEPOT",
            "EXCHANGE",
            "GATE",
            "GENERIC_BUILDING",
            "LIBRARY",
            "OFFICE",
            "PORT",
            "SERVICE_OFFICE",
            "STRUCTURED_WAREHOUSE"
          ]
        },
        "usage": {
          "enum": [
            "DECLARED",
            "DIRECT"
          ]
        }
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative"
      ],
      "properties": {
        "positive": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/fixtureId"
          },
          "uniqueItems": true
        },
        "negative": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/fixtureId"
          },
          "uniqueItems": true
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "license"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "ecosystem",
        "match",
        "negativePredicates",
        "produces",
        "requiredEvidence",
        "fixtures",
        "references",
        "changeSummary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "ecosystem": {
          "enum": [
            "maven",
            "npm"
          ]
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "negativePredicates": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/predicate"
          },
          "uniqueItems": true
        },
        "produces": {
          "$ref": "#/$defs/produces"
        },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "ANNOTATION",
              "AST",
              "CALL",
              "CONFIG",
              "IMPORT",
              "INHERITANCE",
              "MANIFEST"
            ]
          },
          "uniqueItems": true
        },
        "fixtures": {
          "$ref": "#/$defs/fixtures"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true
        },
        "changeSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    }
  }
}
