{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metropogits.dev/schemas/history-0.1.schema.json",
  "title": "MetropoGits History Timeline v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositoryId",
    "frames",
    "transitions",
    "lineages"
  ],
  "properties": {
    "schemaVersion": {
      "const": "history/0.1"
    },
    "repositoryId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "frames": {
      "type": "array",
      "minItems": 2,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/frame"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "lineages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lineage"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "idList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "revision",
        "ucgDigest",
        "cityDigest",
        "buildingCount"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ucgDigest": {
          "$ref": "#/$defs/digest"
        },
        "cityDigest": {
          "$ref": "#/$defs/digest"
        },
        "buildingCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromRevision",
        "toRevision",
        "addedEntityIds",
        "removedEntityIds",
        "changedEntityIds",
        "unchangedEntityIds"
      ],
      "properties": {
        "fromRevision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "toRevision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "addedEntityIds": {
          "$ref": "#/$defs/idList"
        },
        "removedEntityIds": {
          "$ref": "#/$defs/idList"
        },
        "changedEntityIds": {
          "$ref": "#/$defs/idList"
        },
        "unchangedEntityIds": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "lineageRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "entityId",
        "stateDigest"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "entityId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stateDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineageId",
        "path",
        "firstRevision",
        "lastRevision",
        "revisions"
      ],
      "properties": {
        "lineageId": {
          "type": "string",
          "pattern": "^lineage:sha256:[0-9a-f]{64}$"
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "firstRevision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "lastRevision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lineageRevision"
          }
        }
      }
    }
  }
}
