{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metropogits.dev/schemas/planning-0.2.schema.json",
  "title": "Soft functional influence and mixed occupancy over existing streets",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "zoningVersion", "worldSeed", "ucgDigest", "sourceCityDigest", "terrainPreset", "zones", "optimization", "baseGeneratorVersion", "addressDigest"],
  "properties": {
    "schemaVersion": {"const": "planning/0.2-experimental"}, "zoningVersion": {"const": "soft-zoning/0.1"},
    "worldSeed": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "ucgDigest": {"$ref": "#/$defs/digest"}, "sourceCityDigest": {"$ref": "#/$defs/digest"}, "addressDigest": {"$ref": "#/$defs/digest"},
    "terrainPreset": {"const": "flat"}, "baseGeneratorVersion": {"type": "string"},
    "zones": {"type": "array", "minItems": 1, "maxItems": 448, "items": {"$ref": "#/$defs/zone"}},
    "optimization": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "required": ["districtId", "sourcePairCount", "optimizedPairCount", "swaps", "energyBefore", "energyAfter", "meanDependencyDistanceBefore", "meanDependencyDistanceAfter", "workLimitReached"]}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -100000, "maximum": 100000}},
    "ids": {"type": "array", "uniqueItems": true, "maxItems": 10000, "items": {"type": "string"}},
    "claims": {"type": "array", "maxItems": 10000, "items": {"type": "object", "required": ["entityId", "roles"], "properties": {"entityId": {"type": "string"}, "roles": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["value", "confidence", "evidenceIds"], "properties": {"value": {"type": "string"}, "confidence": {"enum": ["DIRECT", "RESOLVED", "INFERRED", "UNKNOWN"]}, "evidenceIds": {"$ref": "#/$defs/ids"}}}}}}},
    "zone": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "parentId", "clusterKey", "label", "classification", "referenceEntityIds", "referenceClaims", "memberEntityIds", "memberClaims", "requestedProfile", "planningProfile", "polygon", "anchor", "areaAllocated", "allocation"],
      "properties": {
        "id": {"type": "string", "pattern": "^world:zone:[0-9a-f]{16}$"}, "parentId": {"type": "string"},
        "clusterKey": {"enum": ["GENERAL_MIXED", "SERVICE_QUARTER", "INDUSTRIAL_LOGISTICS", "CAMPUS_RESEARCH", "GATEWAY_CIVIC", "COMMERCIAL_FRONTEND"]},
        "label": {"type": "string"},
        "classification": {"type": "object", "required": ["status", "evidenceIds", "ruleIds"], "properties": {"status": {"enum": ["INFERRED", "UNKNOWN"]}, "evidenceIds": {"$ref": "#/$defs/ids"}, "ruleIds": {"$ref": "#/$defs/ids"}}},
        "referenceEntityIds": {"$ref": "#/$defs/ids"}, "referenceClaims": {"$ref": "#/$defs/claims"},
        "memberEntityIds": {"$ref": "#/$defs/ids"}, "memberClaims": {"$ref": "#/$defs/claims"},
        "requestedProfile": {"type": "string"}, "planningProfile": {"enum": ["GRID", "ORGANIC", "RADIAL", "INDUSTRIAL", "HYBRID"]},
        "polygon": {"type": "array", "minItems": 3, "maxItems": 512, "items": {"$ref": "#/$defs/point"}},
        "anchor": {"$ref": "#/$defs/point"}, "areaAllocated": {"type": "number", "exclusiveMinimum": 0},
        "allocation": {"type": "object", "required": ["algorithm", "iterations", "maxRelativeAreaError"]}
      }
    }
  }
}
