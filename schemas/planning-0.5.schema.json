{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metropogits.dev/schemas/planning-0.5.schema.json",
  "title": "Relationship-mixed neighborhoods and adaptive shared pattern hierarchy",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion","zoningVersion","patternScale","districtPatterns","worldSeed","ucgDigest","sourceCityDigest","terrainPreset","zones","blocks","mainRoads"],
  "properties": {
    "schemaVersion": {"const":"planning/0.5-experimental"},
    "zoningVersion": {"const":"functional-neighborhoods/0.1"},
    "patternScale": {"const":"adaptive"},
    "districtPatterns": {"type":"array","minItems":1,"maxItems":64,"items":{"type":"object","required":["id","version","parentId","profile","seed","protectedStreetIds","fullFieldRoadCount","roadCount"],"properties":{"version":{"enum":["adaptive-patterns/0.1","adaptive-patterns/0.2"]},"profile":{"enum":["GRID","ORGANIC","RADIAL","INDUSTRIAL","HYBRID"]}}}},
    "worldSeed": {"type":"string","pattern":"^[0-9a-f]{16}$"},
    "ucgDigest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "sourceCityDigest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "terrainPreset": {"const":"flat"},
    "zones": {"type":"array","minItems":1,"maxItems":448,"items":{"type":"object","required":["id","parentId","clusterKey","classification","coreEntityIds","coreClaims","supportingMembers","structuralMemberEntityIds","internalEdgeIds","roleCounts","memberEntityIds","memberClaims","polygon","accessPorts","planningProfile"],"properties":{"planningProfile":{"const":"BLOCK_LOCAL"},"internalEdgeIds":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"memberEntityIds":{"type":"array","uniqueItems":true,"items":{"type":"string"}}}}},
    "blocks": {"type":"array","minItems":1,"maxItems":448,"items":{"type":"object","required":["id","zoneId","memberEntityIds","polygon","boundaryTypes","planningProfile","capacity","affinity","inheritedPatternId","patternMode"],"properties":{"patternMode":{"enum":["INHERITED","ADAPTED"]},"boundaryTypes":{"type":"array","items":{"const":"NEIGHBORHOOD_BOUNDARY"}},"planningProfile":{"enum":["GRID","ORGANIC","RADIAL","INDUSTRIAL","HYBRID"]},"capacity":{"type":"integer","minimum":1}}}},
    "mainRoads": {"type":"array","maxItems":10000,"items":{"type":"object","required":["id","start","end","width","structural","patternId"],"properties":{"structural":{"const":true},"width":{"type":"number","exclusiveMinimum":0}}}}
  }
}
