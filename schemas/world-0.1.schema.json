{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metropogits.dev/schemas/world-0.1.schema.json",
  "title": "Experimental flat physical world; does not replace City v0.2",
  "type": "object",
  "additionalProperties": false,
  "allOf":[{"if":{"properties":{"generatorVersion":{"const":"terrain-adaptive/0.3"}}},"then":{"required":["surface"]}}],
  "required": ["schemaVersion","generatorVersion","seed","seedAlgorithm","repositoryNamespace","sourceCityDigest","ucgDigest","coordinateSystem","coordinateQuantum","terrainPreset","allocationAlgorithm","envelope","districts","logicalDistricts","topology","parcels","streets","routing","networks","coverage","diagnostics","anchors"],
  "properties": {
    "schemaVersion": {"const":"world/0.1-experimental"},
    "generatorVersion": {"enum":["flat-capacity/0.1","flat-planning/0.2","flat-planning/0.3","flat-world/0.4","flat-zoning/0.1","flat-soft-zoning/0.1","flat-neighborhoods/0.1","flat-neighborhood-patterns/0.1","flat-adaptive-neighborhoods/0.1","flat-adaptive-neighborhoods/0.2","flat-adaptive-neighborhoods/0.3","flat-adaptive-neighborhoods/0.4","flat-adaptive-neighborhoods/0.5","terrain-adaptive/0.1","terrain-adaptive/0.2","terrain-adaptive/0.3"]},
    "surface":{"type":"object","additionalProperties":false,"required":["version","spacing","origin","values","faces"],"properties":{
      "version":{"const":"surface/0.1"},"spacing":{"const":16},"origin":{"$ref":"#/$defs/point"},
      "values":{"type":"array","minItems":2,"maxItems":512,"items":{"type":"array","minItems":2,"maxItems":512,"items":{"type":"number","minimum":0,"maximum":18}}},
      "faces":{"type":"array","maxItems":65536,"items":{"type":"object","required":["points","color"],"properties":{
        "color":{"type":"string","pattern":"^#[0-9a-f]{6}$"},"points":{"type":"array","minItems":3,"maxItems":16,"items":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}}}}}}
    }},
    "streetPolicy": {"enum":["original","shared","permeable"]},
    "terrain": {
      "type":"object", "additionalProperties":false,
      "required":["version","preset","seed","environmental","initialEnvelope","surfacePolicy","features","protectedArea"],
      "properties": {
        "version":{"enum":["terrain/0.1","terrain/0.2","terrain/0.3"]}, "preset":{"enum":["lake-district","river-corridor","river-valley"]},
        "seed":{"type":"string","pattern":"^[0-9a-f]{16}$"}, "environmental":{"const":true},
        "initialEnvelope":{"$ref":"#/$defs/polygon"}, "surfacePolicy":{"enum":["flat-buildable-plains","graded-ground-level-foundations"]},
        "elevation":{"type":"object","additionalProperties":false,"required":["version","seed","spacing","amplitude","riseLength","flatRadius"],"properties":{
          "version":{"const":"surface-field/0.1"},"seed":{"type":"string","pattern":"^[0-9a-f]{16}$"},"spacing":{"const":16},"waterAttempt":{"type":"integer","minimum":1,"maximum":3},
          "amplitude":{"type":"number","minimum":6,"maximum":18},"riseLength":{"type":"number","minimum":90,"maximum":10000},"flatRadius":{"type":"number","minimum":32,"maximum":1000}}},
        "protectedArea":{"type":"number","exclusiveMinimum":0},
        "channel":{"type":"object","additionalProperties":false,"required":["centerline","waterLevel","policy"],"properties":{
          "centerline":{"type":"array","minItems":9,"maxItems":9,"items":{"$ref":"#/$defs/point"}},
          "waterLevel":{"const":0.09},"policy":{"const":"analytical-connected-channel-not-drainage-simulation"}}},
        "crossings":{"type":"array","minItems":1,"maxItems":3,"items":{"type":"object","additionalProperties":false,
          "required":["id","path","heights","width","maxGrade","clearance","structural"],"properties":{
          "id":{"type":"string"},"path":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/point"}},
          "heights":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number","minimum":0.08,"maximum":0.95}},
          "width":{"const":4.5},"maxGrade":{"const":0.16},"clearance":{"type":"number","minimum":0.6,"maximum":0.86},"structural":{"const":true}}}},
        "features":{"type":"array","minItems":1,"maxItems":24,"items":{
          "type":"object", "required":["id","kind","center","polygon","noBuildPolygon","roadPolygon","height","faces"],
          "properties":{
            "kind":{"enum":["LAKE","HILL","RIVER"]}, "center":{"$ref":"#/$defs/point"},
            "polygon":{"$ref":"#/$defs/polygon"}, "noBuildPolygon":{"$ref":"#/$defs/polygon"}, "roadPolygon":{"$ref":"#/$defs/polygon"},
            "height":{"type":"number","minimum":0,"maximum":15},
            "faces":{"type":"array","maxItems":64,"items":{"type":"object","required":["points","color"],"properties":{
              "points":{"type":"array","minItems":3,"maxItems":16,"items":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}}},
              "color":{"type":"string","pattern":"^#[0-9a-f]{6}$"}
            }}}
          }
        }}
      },
      "allOf":[{"if":{"properties":{"version":{"const":"terrain/0.1"}}},
        "then":{"properties":{"preset":{"const":"lake-district"},"features":{"maxItems":5}},"not":{"anyOf":[{"required":["channel"]},{"required":["crossings"]}]}},
        "else":{"required":["channel","crossings"],"if":{"properties":{"version":{"const":"terrain/0.2"}}},
          "then":{"properties":{"preset":{"const":"river-corridor"}},"not":{"required":["elevation"]}},
          "else":{"required":["elevation"],"properties":{"preset":{"const":"river-valley"},"surfacePolicy":{"const":"graded-ground-level-foundations"}}}}}]
    },
    "patternScale": {"enum":["district","adaptive"]},
    "zoningPolicy": {"enum":["semantic","soft","neighborhoods"]},
    "softZoning": {"type":"object","additionalProperties":false,"required":["version","baseGeneratorVersion","zones","optimization","addressDigest"],"properties":{"version":{"const":"soft-zoning/0.1"},"baseGeneratorVersion":{"type":"string"},"addressDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"zones":{"type":"array","minItems":1,"maxItems":448},"optimization":{"type":"array","maxItems":64}}},
    "zoning": {"type":"object","additionalProperties":false,"required":["version","zones"],"properties":{"version":{"enum":["semantic-zoning/0.1","neighborhoods/0.1","functional-neighborhoods/0.1"]},"districtPatterns":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"object","required":["id","version","parentId","profile","seed","primaryAxis","slotCapacity","roadCount"],"properties":{"version":{"enum":["district-patterns/0.1","adaptive-patterns/0.1","adaptive-patterns/0.2","adaptive-patterns/0.3"]},"profile":{"enum":["GRID","ORGANIC","RADIAL","INDUSTRIAL","HYBRID"]}}}},"blocks":{"type":"array","minItems":1,"maxItems":1024},"mainRoads":{"type":"array","maxItems":10000},"zones":{"type":"array","minItems":1,"maxItems":448,"items":{"type":"object","required":["id","parentId","clusterKey","classification","memberEntityIds","memberClaims","polygon","anchor","planningSeed","planningProfile","areaDemand","areaAllocated","capacity","allocation"],"properties":{"polygon":{"$ref":"#/$defs/polygon"},"memberEntityIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}}}}}}},
    "outlinePolicy": {"enum":["ellipse","varied"]},
    "outlineVersion": {"const":"seeded-convex/1"},
    "outlineFamily": {"enum":["compact","elongated","angular","asymmetric"]},
    "planningPolicy": {"enum":["grid","mixed","radial","organic","industrial","hybrid","varied"]},
    "seed": {"type":"string","pattern":"^[0-9a-f]{16}$"},
    "seedAlgorithm": {"const":"sha256-counter/1"},
    "repositoryNamespace": {"type":"string","minLength":1},
    "sourceCityDigest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "ucgDigest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "coordinateSystem": {"const":"x-z-ground-y-up"},
    "coordinateQuantum": {"const":0.0001},
    "terrainPreset": {"enum":["flat","lake-district","river-corridor","river-valley"]},
    "allocationAlgorithm": {"const":"capacity-bisection/0.1"},
    "envelope": {"$ref":"#/$defs/polygon"},
    "districts": {"type":"array","minItems":1,"maxItems":64,"items":{"type":"object","required":["id","sourceDirectoryId","label","polygon","anchor","localSeed","planningProfile","primaryAxis","areaDemand","areaAllocated","capacity","buildingCount"],"properties":{"id":{"type":"string"},"polygon":{"$ref":"#/$defs/polygon"},"planningProfile":{"enum":["GRID","RADIAL","ORGANIC","INDUSTRIAL","HYBRID","ZONED"]},"planningRegions":{"type":"array","minItems":2,"maxItems":4,"items":{"type":"object","required":["id","polygon","planningProfile","areaAllocated"],"properties":{"polygon":{"$ref":"#/$defs/polygon"},"planningProfile":{"enum":["GRID","ORGANIC"]}}}},"areaAllocated":{"type":"number","exclusiveMinimum":0},"capacity":{"type":"integer","minimum":1},"buildingCount":{"type":"integer","minimum":1}}}},
    "logicalDistricts": {"type":"array","items":{"type":"object","required":["id","parentId"]}},
    "topology": {"type":"object","required":["edges"],"properties":{"edges":{"type":"array","items":{"type":"object","required":["id","start","end","districtIds"],"properties":{"start":{"$ref":"#/$defs/point"},"end":{"$ref":"#/$defs/point"},"districtIds":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"type":"string"}}}}}}},
    "parcels": {"type":"array","minItems":1,"maxItems":10000,"items":{"type":"object","required":["entityId","sourceDistrictId","districtId","slotId","blockId","center","angle","footprint","parts","parcel","entrance","streetPoint","archetype","width","depth","height","evidenceIds","styleVariant"],"properties":{"entityId":{"type":"string"},"footprint":{"$ref":"#/$defs/polygon"},"parcel":{"$ref":"#/$defs/polygon"},"center":{"$ref":"#/$defs/point"},"entrance":{"$ref":"#/$defs/point"},"angle":{"type":"number"},"parts":{"type":"array","minItems":1,"items":{"type":"object","required":["footprint","height","y"],"properties":{"footprint":{"$ref":"#/$defs/polygon"}}}}}}},
    "streets": {"type":"array","maxItems":50000,"items":{"type":"object","required":["id","kind","start","end","width","access"],"properties":{
      "kind":{"const":"STRUCTURAL"},"start":{"$ref":"#/$defs/point"},"end":{"$ref":"#/$defs/point"},"width":{"type":"number","exclusiveMinimum":0},"access":{"type":"boolean"},
      "heights":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number","minimum":0,"maximum":20}},
      "heightProfile":{"type":"array","minItems":2,"maxItems":256,"items":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}}}
    }}},
    "routing": {"type":"object","required":["version","status","routes","segments","junctions","unresolvedEdgeIds","diagnostics"],"properties":{"status":{"const":"COMPLETE"},"routes":{"type":"array","maxItems":25000}}},
    "networks": {"type":"array"},
    "coverage": {"type":"object","required":["internalEdgeIds","nonLocalEdgeIds","searchExpansions"]},
    "diagnostics": {"type":"array"},
    "anchors": {"type":"object","required":["reusedDistrictIds","replannedDistrictIds"]}
  },
  "$defs": {
    "point": {"type":"array","minItems":2,"maxItems":2,"items":{"type":"number","minimum":-100000,"maximum":100000}},
    "polygon": {"type":"array","minItems":3,"maxItems":512,"items":{"$ref":"#/$defs/point"}}
  }
}
